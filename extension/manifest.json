{
  "manifest_version": 3,
  "name": "Segurança Escolar",
  "version": "1.0.0",
  "description": "Bloqueia sites de IA",
  "permissions": ["declarativeNetRequest", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "index.html",
    "default_icon": "assets/icon.png",
    "default_title": "Segurança Escolar"
  },
  "declarative_net_request": {
    "rule_resources": [{ "id": "ia", "enabled": true, "path": "rules/ia.json" }]
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "style.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "assets/icon.png",
    "32": "assets/icon.png",
    "48": "assets/icon.png",
    "128": "assets/icon.png"
  }
}
